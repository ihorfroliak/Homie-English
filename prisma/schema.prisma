// Homie English — data model.
// SQLite for local dev; swap `provider` + DATABASE_URL to "postgresql" for
// prod. JSON-shaped fields are stored as TEXT here; on Postgres they become
// jsonb / text[] with a straightforward migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?   // null for future OAuth
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  words         Word[]
  sessions      Session[]
  reviewLogs    ReviewLog[]
}

// Server-side sessions: revocable, unlike a stateless JWT.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Global, deduplicated enrichment. Keyed by the normalized input so a word is
// enriched by the AI exactly once and reused across every user (req #8).
// Designed to scale to millions of rows: single unique lookup on `key`.
model Lexeme {
  id   String @id @default(cuid())
  key  String @unique // normalized text (lowercase, collapsed spaces)
  text String // original display form

  lemma        String?
  partOfSpeech String?
  cefr         String? // A1..C2
  ipaUk        String?
  ipaUs        String?

  translation     String? // natural Ukrainian
  altTranslations String? // JSON string[]
  explanation     String? // simple English, original

  collocations   String? // JSON string[]
  commonMistakes String? // JSON string[]
  synonyms       String? // JSON string[]
  antonyms       String? // JSON string[]
  tags           String? // JSON string[]

  irregularForms String? // free note, when applicable
  plural         String? // when applicable
  verbForms      String? // JSON object, when applicable

  pronunciationTips String?
  mnemonic          String?

  // Provenance for logging / audit.
  source String @default("stub") // "anthropic" | "openai" | ... | "stub"
  model  String?

  examples  Example[]
  words     Word[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Example {
  id          String @id @default(cuid())
  lexemeId    String
  lexeme      Lexeme @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  en          String
  translation String?

  @@index([lexemeId])
}

// Per-user learning state. References the shared Lexeme; only progress and
// scheduling live here (SRS status lifecycle: New -> Learning -> Reviewing ->
// Mastered).
model Word {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lexemeId String
  lexeme   Lexeme @relation(fields: [lexemeId], references: [id], onDelete: Restrict)

  status     String @default("New")
  difficulty String @default("Medium")

  reps         Int      @default(0)
  intervalDays Int      @default(0)
  dueAt        DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewLogs ReviewLog[]

  @@unique([userId, lexemeId])
  @@index([userId, dueAt])
}

// Append-only review history. Cannot be backfilled, so it is recorded from day
// one for streaks and analytics. Survives deleting the word.
model ReviewLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId     String?
  word       Word?    @relation(fields: [wordId], references: [id], onDelete: SetNull)
  grade      String // "again" | "good"
  reviewedAt DateTime @default(now())

  @@index([userId, reviewedAt])
}
