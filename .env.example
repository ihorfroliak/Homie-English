# Copy to .env and fill in.

# --- Database ---------------------------------------------------------------
# SQLite for local dev (zero infra). Swap to a Postgres URL for prod.
DATABASE_URL="file:./dev.db"

# --- AI enrichment ----------------------------------------------------------
# Active provider. One of: anthropic | stub  (openai/gemini reserved).
AI_PROVIDER="anthropic"

# Anthropic key. When empty (or the call fails) enrichment falls back to a
# deterministic stub, so the app always works with no key configured.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Per-request timeout (ms) for a single provider attempt.
AI_TIMEOUT_MS="60000"

# In-process rate-limit guard: max provider calls per minute.
AI_MAX_RPM="60"
